{
  "name": "vencakrecl/wp-dev",
  "description": "Standalone WordPress development tools powered by Castor and WP-CLI.",
  "type": "project",
  "require": {
    "php": "^8.5"
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": {
      "bamarni/composer-bin-plugin": true
    }
  },
  "require-dev": {
    "bamarni/composer-bin-plugin": "^1.8",
    "friendsofphp/php-cs-fixer": "^3",
    "phpstan/phpstan": "^2",
    "phpunit/phpunit": "^12"
  },
  "extra": {
    "bamarni-bin": {
      "bin-links": true,
      "forward-command": true
    }
  },
  "autoload": {
    "psr-4": {
      "WPDev\\": "src/"
    },
    "files": [
      "src/_context.php",
      "src/_helpers.php"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "WPDev\\Tests\\": "tests/"
    }
  }
}
